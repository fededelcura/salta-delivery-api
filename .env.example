# SQL Server — copiá a .env y completá con tus valores reales (NO subir .env)
SQLSERVER_SERVER=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=salta_delivery
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TRUST_CERTIFICATE=true
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUSTED_CONNECTION=false

# Redis (opcional)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Auth
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Mercado Pago (opcional)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
