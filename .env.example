# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=salta_delivery
PGUSER=postgres
PGPASSWORD=
DATABASE_URL=postgresql://postgres:TU_CLAVE@127.0.0.1:5432/salta_delivery

REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development
# En producción: URL del front en Render, ej. https://salta-delivery-web.onrender.com
# Varias origins: separadas por coma. Local: *
CORS_ORIGIN=*

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Email OTP (Resend). Sin key: el código se imprime en logs de la API.
RESEND_API_KEY=
MAIL_FROM=Salta Delivery <onboarding@resend.dev>

# Web Push al cadete. Generar con: npx web-push generate-vapid-keys. Sin claves: push apagado.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@saltadelivery.com
